# Anmälningsformuläret skickar e-post via Resend (https://resend.com).
# Utan RESEND_API_KEY returnerar formuläret ett vänligt felmeddelande
# och loggar anmälan i serverloggen istället för att tappa den tyst.

RESEND_API_KEY=
# Adressen som anmälningar skickas till
ANMALAN_EPOST=
# Avsändare. Måste vara en verifierad domän i Resend, t.ex.
# "Norrhed Skog <anmalan@timringskurs.nu>"
ANMALAN_AVSANDARE=

# --- Sanity (innehållet Ola redigerar på /studio) ---
# Projekt-ID och dataset har standardvärden i sanity/env.ts och behöver inte
# sättas. Fyll bara i om du vill peka mot ett annat Sanity-projekt.
# NEXT_PUBLIC_SANITY_PROJECT_ID=pv9m05mm
# NEXT_PUBLIC_SANITY_DATASET=production
# NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01
# Valfri hemlighet, hittas på: sanity.io/manage → API → Webhooks.
# Samma sträng anges i webhooken så att sajten uppdateras direkt vid publicering.
SANITY_REVALIDATE_SECRET=
